# Classic Blackfin (ADSP-BF53x) SLEIGH language.
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Encodings and assembly syntax follow the GNU binutils Blackfin disassembler
# (the decoding oracle); execution semantics follow the GNU simulator (the
# semantic oracle). Circular DAG addressing (L0-L3 != 0) is not modelled: the
# I registers are plain pointers, as the GCC ABI requires. The byte-video
# operations (BYTEOP*, SAA) are opaque user operations.

define endian=little;
define alignment=2;

define space ram type=ram_space size=4 default;
define space register type=register_space size=4;

define register offset=0x000 size=4 [ R0 R1 R2 R3 R4 R5 R6 R7 ];
define register offset=0x000 size=2 [ R0.L R0.H R1.L R1.H R2.L R2.H R3.L R3.H R4.L R4.H R5.L R5.H R6.L R6.H R7.L R7.H ];
define register offset=0x000 size=1 [ R0.B _ _ _ R1.B _ _ _ R2.B _ _ _ R3.B _ _ _ R4.B _ _ _ R5.B _ _ _ R6.B _ _ _ R7.B _ _ _ ];
define register offset=0x020 size=4 [ P0 P1 P2 P3 P4 P5 SP FP ];
define register offset=0x020 size=2 [ P0.L P0.H P1.L P1.H P2.L P2.H P3.L P3.H P4.L P4.H P5.L P5.H SP.L SP.H FP.L FP.H ];
define register offset=0x040 size=4 [ I0 I1 I2 I3 M0 M1 M2 M3 B0 B1 B2 B3 L0 L1 L2 L3 ];
define register offset=0x040 size=2 [ I0.L I0.H I1.L I1.H I2.L I2.H I3.L I3.H M0.L M0.H M1.L M1.H M2.L M2.H M3.L M3.H
                                      B0.L B0.H B1.L B1.H B2.L B2.H B3.L B3.H L0.L L0.H L1.L L1.H L2.L L2.H L3.L L3.H ];
# 40-bit accumulators: A0 holds the value in its low five bytes (A0.X is byte 4).
define register offset=0x080 size=8 [ A0 A1 ];
define register offset=0x080 size=4 [ A0.W _ A1.W _ ];
define register offset=0x080 size=2 [ A0.L A0.H _ _ A1.L A1.H _ _ ];
define register offset=0x084 size=1 [ A0.X ];
define register offset=0x08c size=1 [ A1.X ];
define register offset=0x100 size=4 [ RETS LC0 LT0 LB0 LC1 LT1 LB1 CYCLES CYCLES2 USP SEQSTAT SYSCFG RETI RETX RETN RETE EMUDAT IMASK PC ];
# ASTAT is kept as individual status bits; ASTAT_RSV holds its undefined bits.
define register offset=0x180 size=1 [ AZ AN AC0_COPY V_COPY CC AQ RND_MOD AC0 AC1 AV0 AV0S AV1 AV1S V VS ];
define register offset=0x190 size=4 [ ASTAT_RSV MV ];
# Snapshot of R0-R7, P0-P5, SP, FP, I0-I3 and M0-M3 taken before a multi-issue
# packet: its two slots read these, so each slot sees pre-packet values.
define register offset=0x1a0 size=4 [ R0_P R1_P R2_P R3_P R4_P R5_P R6_P R7_P ];
define register offset=0x1a0 size=2 [ R0_P.L R0_P.H R1_P.L R1_P.H R2_P.L R2_P.H R3_P.L R3_P.H R4_P.L R4_P.H R5_P.L R5_P.H R6_P.L R6_P.H R7_P.L R7_P.H ];
define register offset=0x2a0 size=4 [ P0_P P1_P P2_P P3_P P4_P P5_P SP_P FP_P I0_P I1_P I2_P I3_P M0_P M1_P M2_P M3_P ];
# DSP32 scratch: multiplier inputs, products, accumulator working values and
# per-MAC results, written and consumed within one instruction.
define register offset=0x200 size=8 [ PR1 PR0 ACC1 ACC0 ACN1 ACN0 ];
define register offset=0x240 size=4 [ RES1 RES0 ];
define register offset=0x250 size=2 [ MA1 MB1 MA0 MB0 ];
define register offset=0x260 size=1 [ PSAT1 PSAT0 ASAT1 ASAT0 OVF1 OVF0 SGN1 SGN0 VV1 VV0 ZZ1 ZZ0 NN1 NN0 ];
define register offset=0x1e0 size=12 contextreg;
# par: decoding a multi-issue slot. lbot0/lbot1: this instruction ends the LC0/LC1
# hardware loop whose top is ltop0/ltop1 (set by LSETUP through globalset).
define context contextreg
  par=(0,0) noflow
  lbot0=(1,1) noflow
  lbot1=(2,2) noflow
  ltop0=(32,63) noflow
  ltop1=(64,95) noflow
;

define pcodeop idle;
define pcodeop emuexcpt;
define pcodeop raise;
define pcodeop excpt;
define pcodeop prefetch;
define pcodeop flushinv;
define pcodeop flush;
define pcodeop iflush;
define pcodeop dbg;
define pcodeop outc;
define pcodeop dbg_assert;
define pcodeop abort;
define pcodeop halt;
define pcodeop saa;
define pcodeop byteop1p;
define pcodeop byteop16p;
define pcodeop byteop16m;
define pcodeop byteop2p;
define pcodeop byteop3p;
define pcodeop disalgnexcpt;

# Instruction word (16-bit instructions, the first word of 32-bit ones and the
# two parallel slots of a multi-issue packet).
define token instr(16)
  op=(0,15)
  w0_1=(0,1) w0_2=(0,2) w0_3=(0,3) w0_4=(0,4) w0_5=(0,5) w0_7=(0,7) w0_7s=(0,7) signed
  w0_9s=(0,9) signed w0_10=(0,10) w0_11s=(0,11) signed w0_2d=(0,2) dec
  w2_3=(2,3) w3_4=(3,4) w3_5=(3,5) w3_5s=(3,5) signed w3_5d=(3,5) dec w3_7=(3,7) w3_9s=(3,9) signed
  w2=(2,2) w3=(3,3) w4=(4,4) w4_7=(4,7) w4_8=(4,8) w4_15=(4,15) w5=(5,5) w5_6=(5,6) w5_8=(5,8) w5_15=(5,15)
  w6=(6,6) w6_7=(6,7) w6_8=(6,8) w6_9=(6,9) w6_15=(6,15) w7=(7,7) w7_8=(7,8) w7_9=(7,9) w7_15=(7,15)
  w8=(8,8) w8_10=(8,10) w8_15=(8,15) w9=(9,9) w9_10=(9,10) w9_11=(9,11) w9_15=(9,15)
  w10=(10,10) w10_11=(10,11) w10_15=(10,15) w11=(11,11) w11_15=(11,15) w12=(12,12) w12_15=(12,15) w13_15=(13,15)
  w14_15=(14,15)
  dr0=(0,2) dr0b=(0,2) dr3=(3,5) dr6=(6,8)
  dl0=(0,2) dl3=(3,5) dl6=(6,8) dh0=(0,2) dh3=(3,5) dh6=(6,8) db3=(3,5)
  pr0=(0,2) pr0b=(0,2) pr3=(3,5) pr6=(6,8)
  sd0=(0,2) sd6=(6,8) sdl0=(0,2) sdh0=(0,2) sdl6=(6,8) sdh6=(6,8)
  sp0=(0,2) sp3=(3,5) si0=(0,1) si3=(3,4) sm2=(2,3) sm5=(5,6) sdp0=(0,3)
  im0=(0,2) im3=(3,5) bl0=(0,2) bl3=(3,5) lc0=(0,2) lc3=(3,5) sy0=(0,2) sy3=(3,5)
  ir0=(0,1) ir3=(3,4) mr2=(2,3) mr5=(5,6)
  dp0=(0,3)
  rg0=(0,4) rgl0=(0,4) rgh0=(0,4)
  psr=(0,5) ppr=(0,5)
  cbit=(0,4) cbn=(0,4)
;

# Second word of a 32-bit instruction.
define token ext(16)
  x0_15=(0,15) x0_15s=(0,15) signed x0_7=(0,7)
  x0_2=(0,2) x0_9=(0,9) x3_5=(3,5) x3_8=(3,8) x3_8s=(3,8) signed x6_8=(6,8) x8=(8,8) x9=(9,9) x9_11=(9,11) x10=(10,10)
  x10_11=(10,11) x11_12=(11,12) x12=(12,12) x12_13=(12,13) x12_15=(12,15) x13=(13,13) x14=(14,14) x14_15=(14,15) x15=(15,15)
  xdr0=(0,2) xdr3=(3,5) xdr6=(6,8) xdr9=(9,11) xdl0=(0,2) xdl3=(3,5) xdl6=(6,8) xdl9=(9,11) xdh0=(0,2) xdh3=(3,5) xdh6=(6,8) xdh9=(9,11)
  xdr9b=(9,11) xdl9b=(9,11) xdr3b=(3,5) xdr0b=(0,2) x6_7=(6,7) x0_1=(0,1) x3_4=(3,4)
  xpr12=(12,14)
;

attach variables [ dr0 dr0b dr3 dr6 xdr0 xdr3 xdr6 xdr9 xdr9b xdr3b xdr0b ] [ R0 R1 R2 R3 R4 R5 R6 R7 ];
attach variables [ dl0 dl3 dl6 xdl0 xdl3 xdl6 xdl9 xdl9b ] [ R0.L R1.L R2.L R3.L R4.L R5.L R6.L R7.L ];
attach variables [ dh0 dh3 dh6 xdh0 xdh3 xdh6 xdh9 ] [ R0.H R1.H R2.H R3.H R4.H R5.H R6.H R7.H ];
attach variables [ db3 ] [ R0.B R1.B R2.B R3.B R4.B R5.B R6.B R7.B ];
attach variables [ pr0 pr0b pr3 pr6 xpr12 ] [ P0 P1 P2 P3 P4 P5 SP FP ];
attach variables [ sd0 sd6 ] [ R0_P R1_P R2_P R3_P R4_P R5_P R6_P R7_P ];
attach variables [ sdl0 sdl6 ] [ R0_P.L R1_P.L R2_P.L R3_P.L R4_P.L R5_P.L R6_P.L R7_P.L ];
attach variables [ sdh0 sdh6 ] [ R0_P.H R1_P.H R2_P.H R3_P.H R4_P.H R5_P.H R6_P.H R7_P.H ];
attach variables [ sp0 sp3 ] [ P0_P P1_P P2_P P3_P P4_P P5_P SP_P FP_P ];
attach variables [ si0 si3 ] [ I0_P I1_P I2_P I3_P ];
attach variables [ sm2 sm5 ] [ M0_P M1_P M2_P M3_P ];
attach variables [ sdp0 ] [ R0_P R1_P R2_P R3_P R4_P R5_P R6_P R7_P P0_P P1_P P2_P P3_P P4_P P5_P SP_P FP_P ];
attach variables [ im0 im3 ] [ I0 I1 I2 I3 M0 M1 M2 M3 ];
attach variables [ bl0 bl3 ] [ B0 B1 B2 B3 L0 L1 L2 L3 ];
attach variables [ lc0 lc3 ] [ LC0 LT0 LB0 LC1 LT1 LB1 CYCLES CYCLES2 ];
attach variables [ sy0 sy3 ] [ USP SEQSTAT SYSCFG RETI RETX RETN RETE EMUDAT ];
attach variables [ ir0 ir3 ] [ I0 I1 I2 I3 ];
attach variables [ mr2 mr5 ] [ M0 M1 M2 M3 ];
attach variables [ dp0 ] [ R0 R1 R2 R3 R4 R5 R6 R7 P0 P1 P2 P3 P4 P5 SP FP ];
attach variables [ rg0 ] [ R0 R1 R2 R3 R4 R5 R6 R7 P0 P1 P2 P3 P4 P5 SP FP I0 I1 I2 I3 M0 M1 M2 M3 B0 B1 B2 B3 L0 L1 L2 L3 ];
attach variables [ rgl0 ] [ R0.L R1.L R2.L R3.L R4.L R5.L R6.L R7.L P0.L P1.L P2.L P3.L P4.L P5.L SP.L FP.L
                            I0.L I1.L I2.L I3.L M0.L M1.L M2.L M3.L B0.L B1.L B2.L B3.L L0.L L1.L L2.L L3.L ];
attach variables [ rgh0 ] [ R0.H R1.H R2.H R3.H R4.H R5.H R6.H R7.H P0.H P1.H P2.H P3.H P4.H P5.H SP.H FP.H
                            I0.H I1.H I2.H I3.H M0.H M1.H M2.H M3.H B0.H B1.H B2.H B3.H L0.H L1.H L2.H L3.H ];
# Register groups 0-7 x register 0-7 as one 6-bit field (push, pop, DBG). A0.X,
# A1.X and ASTAT need special handling and are left out here.
attach variables [ psr ] [ R0 R1 R2 R3 R4 R5 R6 R7 P0 P1 P2 P3 P4 P5 _ FP
                           I0 I1 I2 I3 M0 M1 M2 M3 B0 B1 B2 B3 L0 L1 L2 L3
                           _ A0.W _ A1.W _ _ _ RETS _ _ _ _ _ _ _ _
                           LC0 LT0 LB0 LC1 LT1 LB1 CYCLES CYCLES2 USP SEQSTAT SYSCFG RETI RETX RETN RETE EMUDAT ];
attach variables [ ppr ] [ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
                           I0 I1 I2 I3 M0 M1 M2 M3 B0 B1 B2 B3 L0 L1 L2 L3
                           _ A0.W _ A1.W _ _ _ RETS _ _ _ _ _ _ _ _
                           LC0 _ LB0 LC1 _ LB1 CYCLES CYCLES2 USP _ SYSCFG RETI RETX RETN RETE EMUDAT ];
attach variables [ cbit ] [ AZ AN AC0_COPY V_COPY _ _ AQ _ RND_MOD _ _ _ AC0 AC1 _ _ AV0 AV0S AV1 AV1S _ _ _ _ V VS _ _ _ _ _ _ ];

@include "bfin_macros.sinc"
@include "bfin_16.sinc"
@include "bfin_32.sinc"
@include "bfin_dsp.sinc"
@include "bfin_par.sinc"
@include "bfin_loop.sinc"
